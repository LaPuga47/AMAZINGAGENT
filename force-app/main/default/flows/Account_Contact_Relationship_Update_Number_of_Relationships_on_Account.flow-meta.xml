    <recordUpdates>
        <description>Take the sum of (count of AARs and count of ACRs) and use that number to update the &quot;Number of Relationships&quot; field on the Account from the triggering relationship record.</description>
        <name>Update_Number_of_Relationships_on_Account</name>
        <label>Update Number of Relationships on Account</label>
        <locationX>0</locationX>
