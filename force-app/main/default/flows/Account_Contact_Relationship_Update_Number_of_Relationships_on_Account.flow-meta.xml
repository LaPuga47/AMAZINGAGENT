    <description>Runs on Create or Update of Account Contact Relationship, finds relationships related to the AccountID from the Account Contact Relationship that triggered the flow. Flow counts total number of relationships then updates the &quot;Number of Relationships&quot; field on the Account from the Account Contact Relationship that triggered the flow. [Arkus/BL 4-3-26]
v5 - Added Logic to update &quot;Number of Relationships&quot; on Person Account as well. [Arkus/BL 4-3-26]</description>
    <environments>Default</environments>
    <formulas>
        <description>Adds the number of AARs and ACRs</description>
        <name>for_NumberOfRelationships</name>
        <dataType>Number</dataType>
        <expression>{!var_Num_CountAARs} + {!var_Num_CountACRs}</expression>
        <scale>0</scale>
    </formulas>
    <formulas>
        <name>for_NumberOfRelationships_Contact</name>
        <dataType>Number</dataType>
        <expression>{!var_Num_CountAARs_Contact} + {!var_Num_CountACRs_Contact}</expression>
        <scale>0</scale>
    </formulas>
    <interviewLabel>Account Contact Relationship: Update Number of Relationships on Account {!$Flow.CurrentDateTime}</interviewLabel>
    <label>Account Contact Relationship: Update Number of Relationships on Account</label>
    <processMetadataValues>
        <name>BuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>CanvasMode</name>
        <value>
