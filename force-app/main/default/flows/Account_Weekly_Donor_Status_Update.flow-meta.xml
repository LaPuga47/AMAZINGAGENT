    <decisions>
        <name>Determine_Donor_Status</name>
        <label>Determine Donor Status</label>
        <locationX>1106</locationX>
        <locationY>468</locationY>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>New</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>Get_Donor_Gift_Summary.FirstGiftDate</leftValueReference>
                <operator>GreaterThanOrEqualTo</operator>
                <rightValue>
                    <elementReference>f_Last335Days</elementReference>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Update_Acct_New</targetReference>
            </connector>
            <label>New</label>
        </rules>
        <rules>
            <name>Ongoing</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>Get_Donor_Gift_Summary.LastGiftDate</leftValueReference>
                <operator>GreaterThan</operator>
                <rightValue>
                    <elementReference>f_Last365Days</elementReference>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>Get_Donor_Gift_Summary.FirstGiftDate</leftValueReference>
                <operator>LessThanOrEqualTo</operator>
                <rightValue>
                    <elementReference>$Flow.CurrentDate</elementReference>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Update_Acct_Ongoing</targetReference>
            </connector>
            <label>Ongoing</label>
        </rules>
        <rules>
            <name>Soon_to_be_Lapsed</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>Get_Donor_Gift_Summary.LastGiftDate</leftValueReference>
                <operator>GreaterThan</operator>
                <rightValue>
                    <elementReference>f_Last365Days</elementReference>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>Get_Donor_Gift_Summary.LastGiftDate</leftValueReference>
                <operator>LessThanOrEqualTo</operator>
                <rightValue>
                    <elementReference>f_Last335Days</elementReference>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Update_Acct_Soon_Lapsed</targetReference>
            </connector>
            <label>Soon to be Lapsed</label>
        </rules>
        <rules>
            <name>Recent_Lapsed</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>Get_Donor_Gift_Summary.LastGiftDate</leftValueReference>
                <operator>GreaterThan</operator>
                <rightValue>
                    <elementReference>f_Last730Days</elementReference>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>Get_Donor_Gift_Summary.LastGiftDate</leftValueReference>
                <operator>LessThanOrEqualTo</operator>
                <rightValue>
                    <elementReference>f_Last335Days</elementReference>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Update_Acct_Recent_Lapsed</targetReference>
            </connector>
            <label>Recent Lapsed</label>
        </rules>
        <rules>
            <name>Lapsed</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>Get_Donor_Gift_Summary.LastGiftDate</leftValueReference>
                <operator>GreaterThan</operator>
                <rightValue>
                    <elementReference>f_Last1095Days</elementReference>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>Get_Donor_Gift_Summary.LastGiftDate</leftValueReference>
                <operator>LessThanOrEqualTo</operator>
                <rightValue>
                    <elementReference>f_Last730Days</elementReference>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Update_Acct_Lapsed</targetReference>
            </connector>
            <label>Lapsed</label>
        </rules>
        <rules>
            <name>Lapsed_3</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>Get_Donor_Gift_Summary.LastGiftDate</leftValueReference>
                <operator>LessThanOrEqualTo</operator>
                <rightValue>
                    <elementReference>f_Last1095Days</elementReference>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Update_Acct_Lapsed_3</targetReference>
            </connector>
            <label>Lapsed 3+</label>
        </rules>
    </decisions>
    <decisions>
        <name>Donor_Gift_Summary_Found</name>
        <label>Donor Gift Summary Found?</label>
        <locationX>1106</locationX>
        <locationY>360</locationY>
        <defaultConnector>
            <targetReference>Update_Acct_Not_Yet_a_Donor</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>NO</defaultConnectorLabel>
        <rules>
            <name>Yes_Dates_Blank</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>Get_Donor_Gift_Summary.FirstGiftDate</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>No_First_Gift_Update_Status_to_Not_Yet_a_Donor</targetReference>
            </connector>
            <label>Yes, Dates Blank</label>
        </rules>
        <rules>
            <name>YES_DGS_Found</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>Get_Donor_Gift_Summary</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Determine_Donor_Status</targetReference>
            </connector>
            <label>YES</label>
        </rules>
    </decisions>
    <description>This version includes an updated decision to correct the logic for greater than/less than. Arkus(BL) 4-10-25

V3 (Arkus/BL 9-12-25): Added an outcome to the &quot;Donor Gift Summary Found?&quot; decision to account for Donor Gift Summaries where First Gift Date is blank.
V4 (Arkus/BL 9-16-25): Updated decision logic for the decision that checks Donor Gift Summary&apos;s first gift date.</description>
    <environments>Default</environments>
    <formulas>
        <name>f_Last1095Days</name>
        <dataType>Date</dataType>
        <expression>TODAY() - 1095</expression>
    </formulas>
    <formulas>
        <name>f_Last335Days</name>
        <dataType>Date</dataType>
