<?xml version="1.0" encoding="UTF-8"?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>67.0</apiVersion>
    <areMetricsLoggedToDataCloud>false</areMetricsLoggedToDataCloud>
    <decisions>
        <name>Determine_Allocation_Type</name>
        <label>Determine Allocation Type</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnector>
            <targetReference>Determine_Allocation_Type_Pipeline</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>X100_or_Closed_Won</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>$Record.Probability__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <numberValue>100.0</numberValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Update_Allocation_Type</targetReference>
            </connector>
            <label>100% or Closed Won</label>
        </rules>
        <rules>
            <name>X50_99_Likely</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>$Record.Probability__c</leftValueReference>
                <operator>GreaterThanOrEqualTo</operator>
                <rightValue>
                    <numberValue>50.0</numberValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.Probability__c</leftValueReference>
                <operator>LessThanOrEqualTo</operator>
                <rightValue>
                    <numberValue>99.0</numberValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Update_Allocation_Type_to_Likely</targetReference>
            </connector>
            <label>50%–99% → Likely</label>
        </rules>
    </decisions>
    <description>Automatically updates the Allocation Type picklist (Secured, Likely, or Pipeline) based on the related Opportunity&apos;s probability and stage whenever an Allocation is created or updated. This ensures funding classifications remain consistent and eliminates manual updates.

Decision Element Label
Determine Allocation Type

Decision Outcomes

Secured
Opportunity Stage = Closed Won OR Probability = 100%
Likely
Probability ≥ 50% and &lt; 100%
Pipeline
Probability &lt; 50%

By Felix Aila</description>
    <environments>Default</environments>
    <interviewLabel>Determine Allocation Type {!$Flow.CurrentDateTime}</interviewLabel>
    <label>Automatically Classify Allocation Type by Opportunity Probability</label>
    <processMetadataValues>
        <name>BuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>CanvasMode</name>
        <value>
            <stringValue>AUTO_LAYOUT_CANVAS</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>OriginBuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processType>AutoLaunchedFlow</processType>
    <recordUpdates>
        <name>Determine_Allocation_Type_Pipeline</name>
        <label>Determine Allocation Type Pipeline</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <inputAssignments>
            <field>Allocation_Type__c</field>
            <value>
                <stringValue>Pipeline</stringValue>
            </value>
        </inputAssignments>
        <inputReference>$Record</inputReference>
    </recordUpdates>
    <recordUpdates>
        <name>Update_Allocation_Type</name>
        <label>Update Allocation Type Secure</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <inputAssignments>
            <field>Allocation_Status__c</field>
            <value>
                <stringValue>Approved</stringValue>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>Allocation_Type__c</field>
            <value>
                <stringValue>Secured</stringValue>
            </value>
        </inputAssignments>
        <inputReference>$Record</inputReference>
    </recordUpdates>
    <recordUpdates>
        <name>Update_Allocation_Type_to_Likely</name>
        <label>Update  Allocation Type to Likely</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <inputAssignments>
            <field>Allocation_Type__c</field>
            <value>
                <stringValue>Likely</stringValue>
            </value>
        </inputAssignments>
        <inputReference>$Record</inputReference>
    </recordUpdates>
    <start>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <connector>
            <targetReference>Determine_Allocation_Type</targetReference>
        </connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>Probability__c</field>
            <operator>IsNull</operator>
            <value>
                <booleanValue>false</booleanValue>
            </value>
        </filters>
        <object>Allocation__c</object>
        <recordTriggerType>CreateAndUpdate</recordTriggerType>
        <triggerType>RecordAfterSave</triggerType>
    </start>
    <status>Active</status>
</Flow>
