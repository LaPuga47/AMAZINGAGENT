<?xml version="1.0" encoding="UTF-8"?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <actionCalls>
        <description>Sends a reminder to the assigned Grant Reporter 14 Days before the Condition Deadline.</description>
        <name>Send_Condition_Reminder</name>
        <label>Send Condition Reminder</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <actionName>emailSimple</actionName>
        <actionType>emailSimple</actionType>
        <flowTransactionModel>CurrentTransaction</flowTransactionModel>
        <inputParameters>
            <name>emailAddresses</name>
        </inputParameters>
        <inputParameters>
            <name>ccRecipientAddressList</name>
            <value>
                <stringValue>dominic.schmitt@oneacrefund.org</stringValue>
            </value>
        </inputParameters>
        <inputParameters>
            <name>senderType</name>
            <value>
                <stringValue>OrgWideEmailAddress</stringValue>
            </value>
        </inputParameters>
        <inputParameters>
            <name>senderAddress</name>
            <value>
                <stringValue>admin@oneacrefund.org</stringValue>
            </value>
        </inputParameters>
        <inputParameters>
            <name>useEmailTemplate</name>
            <value>
                <stringValue>True</stringValue>
            </value>
        </inputParameters>
        <inputParameters>
            <name>emailTemplateId</name>
            <value>
                <stringValue>00Xcv000001ibJREAY</stringValue>
            </value>
        </inputParameters>
        <inputParameters>
            <name>recipientId</name>
            <value>
                <elementReference>$Record.GiftCommitment.Opportunity_Grant_Reporter__r.Id</elementReference>
            </value>
        </inputParameters>
        <inputParameters>
            <name>relatedRecordId</name>
            <value>
                <elementReference>$Record.Id</elementReference>
            </value>
        </inputParameters>
        <nameSegment>emailSimple</nameSegment>
        <offset>0</offset>
        <versionString>1.0.1</versionString>
    </actionCalls>
    <apiVersion>64.0</apiVersion>
    <areMetricsLoggedToDataCloud>false</areMetricsLoggedToDataCloud>
    <decisions>
        <name>Grant_Opportunity_Stage</name>
        <label>Grant Opportunity Stage</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnector>
            <targetReference>Will_this_Grant_have_a_GA</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>All Other Stages</defaultConnectorLabel>
        <rules>
            <name>Denied_or_Did_Not_Pursue</name>
            <conditionLogic>or</conditionLogic>
            <conditions>
                <leftValueReference>$Record.GiftCommitment.Opportunity.StageName</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Denied</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.GiftCommitment.Opportunity.StageName</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Did not Pursue</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.GiftCommitment.Opportunity.StageName</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Contract negotiation</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.GiftCommitment.Opportunity.StageName</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Proposal submitted</stringValue>
                </rightValue>
            </conditions>
            <label>Denied or Did Not Pursue</label>
        </rules>
    </decisions>
    <decisions>
        <description>Condition Deadline is 14 days out from today&apos;s date where the condition has not been met.</description>
        <name>Is_Today_14_Days_before_Condition_Deadline</name>
        <label>Is Today 14 Days before Condition Deadline</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnectorLabel>No</defaultConnectorLabel>
        <rules>
            <name>YES</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>$Record.Condition_Deadline__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <elementReference>Today_Plus_14</elementReference>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Send_Condition_Reminder</targetReference>
            </connector>
            <label>YES</label>
        </rules>
    </decisions>
    <decisions>
        <description>Filters out those Gift Transactions where the Opportunity does NOT have a GA.</description>
        <name>Will_this_Grant_have_a_GA</name>
        <label>Will this Grant have a GA?</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnectorLabel>No</defaultConnectorLabel>
        <rules>
            <name>Yes_GA</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>$Record.GiftCommitment.Opportunity.Will_this_grant_have_a_GA__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Official grant agreement</stringValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Is_Today_14_Days_before_Condition_Deadline</targetReference>
            </connector>
            <label>Yes</label>
        </rules>
    </decisions>
    <description>This flow generates a reminder email to the Grant Reporter when a Gift Transaction has an upcoming condition deadline due date.</description>
    <environments>Default</environments>
    <formulas>
        <description>14 days from today</description>
        <name>Today_Plus_14</name>
        <dataType>Date</dataType>
        <expression>Today () + 14</expression>
    </formulas>
    <formulas>
        <description>3 Days from Today</description>
        <name>TodayPlus3</name>
        <dataType>Date</dataType>
        <expression>TODAY()+3</expression>
    </formulas>
    <formulas>
        <description>30 Days from Today</description>
        <name>TodayPlus30</name>
        <dataType>Date</dataType>
        <expression>TODAY() +30</expression>
    </formulas>
    <interviewLabel>Condition Deadline Reminder 14 Days {!$Flow.CurrentDateTime}</interviewLabel>
    <label>Gift Transaction: Condition Deadline Reminder 14 Days</label>
    <processMetadataValues>
        <name>BuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>CanvasMode</name>
        <value>
            <stringValue>AUTO_LAYOUT_CANVAS</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>OriginBuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processType>AutoLaunchedFlow</processType>
    <start>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <connector>
            <targetReference>Grant_Opportunity_Stage</targetReference>
        </connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>Transaction_Conditional__c</field>
            <operator>EqualTo</operator>
            <value>
                <stringValue>Yes</stringValue>
            </value>
        </filters>
        <filters>
            <field>Condition_Met__c</field>
            <operator>EqualTo</operator>
            <value>
                <booleanValue>false</booleanValue>
            </value>
        </filters>
        <filters>
            <field>Status</field>
            <operator>NotEqualTo</operator>
            <value>
                <stringValue>Written-Off</stringValue>
            </value>
        </filters>
        <filters>
            <field>Status</field>
            <operator>NotEqualTo</operator>
            <value>
                <stringValue>Paid</stringValue>
            </value>
        </filters>
        <object>GiftTransaction</object>
        <schedule>
            <frequency>Daily</frequency>
            <startDate>2025-06-25</startDate>
            <startTime>03:15:00.000Z</startTime>
        </schedule>
        <triggerType>Scheduled</triggerType>
    </start>
    <status>Active</status>
</Flow>
