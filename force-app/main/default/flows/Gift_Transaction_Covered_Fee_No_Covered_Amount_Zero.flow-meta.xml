    <start>
        <locationX>50</locationX>
        <locationY>0</locationY>
        <connector>
            <targetReference>Update_Covered_Fee_to_Zero</targetReference>
        </connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>Covered_Fee__c</field>
            <operator>EqualTo</operator>
