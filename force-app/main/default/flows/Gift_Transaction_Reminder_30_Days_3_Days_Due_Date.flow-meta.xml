    <apiVersion>64.0</apiVersion>
    <areMetricsLoggedToDataCloud>false</areMetricsLoggedToDataCloud>
    <decisions>
        <description>Grant Payment reminder excludes Debt Prospecting Record Types (DJS 9/29/2025)</description>
        <name>Grant_Opportunity_Stage</name>
        <label>Grant Opportunity Stage</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnector>
            <targetReference>Is_Today_30_Days_or_3_Days_before_Due_Date</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>All Other Stages</defaultConnectorLabel>
        <rules>
            <name>Denied_orDid_Not_Pursue</name>
            <conditionLogic>or</conditionLogic>
            <conditions>
                <leftValueReference>$Record.GiftCommitment.Opportunity.StageName</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Denied</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.GiftCommitment.Opportunity.StageName</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Did not Pursue</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.GiftCommitment.Opportunity.RecordTypeId</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>012cv000000EkJCAA0</stringValue>
                </rightValue>
            </conditions>
            <label>Denied or Did Not Pursue</label>
        </rules>
    </decisions>
    <decisions>
        <description>Today is 30 Days Out or 3 Days Out</description>
        <name>Is_Today_30_Days_or_3_Days_before_Due_Date</name>
        <label>Is Today 30 Days or 3 Days before Due Date</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnectorLabel>No</defaultConnectorLabel>
        <rules>
            <name>Yes</name>
            <conditionLogic>or</conditionLogic>
            <conditions>
                <leftValueReference>$Record.TransactionDueDate</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <elementReference>TodayPlus30</elementReference>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.TransactionDueDate</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <elementReference>TodayPlus3</elementReference>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Send_Payment_Reminder</targetReference>
            </connector>
            <label>Yes</label>
        </rules>
    </decisions>
    <description>DJS: Gift Transaction is due 30 days or 3 days from today or today and is NOT Paid and the Opportunity is not Denied or Did Not Pursue. This flow sends an email alert to the RM.  cc: Dominic on reminders.</description>
    <environments>Default</environments>
    <formulas>
        <description>Today plus 3 to due date</description>
        <name>TodayPlus3</name>
        <dataType>Date</dataType>
        <expression>Today ()+3</expression>
    </formulas>
    <formulas>
        <description>TodayPlus30 for Gift Transactions</description>
        <name>TodayPlus30</name>
        <dataType>Date</dataType>
        <expression>TODAY()+30</expression>
    </formulas>
    <interviewLabel>Gift Transaction Reminder 30 Days 3 Days Due Date {!$Flow.CurrentDateTime}</interviewLabel>
    <label>Gift Transaction Reminder 30 Days 3 Days Due Date</label>
    <processMetadataValues>
        <name>BuilderType</name>
        <value>
