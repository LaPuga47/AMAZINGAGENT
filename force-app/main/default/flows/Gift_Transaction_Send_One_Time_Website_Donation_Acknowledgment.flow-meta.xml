    <decisions>
        <description>If Donor is from the US, they receive an Acknowledgment Email with tax language. If not, they receive an Acknowledgment email without tax language.</description>
        <name>Is_Donor_from_the_US</name>
        <label>Is Donor from the US?</label>
        <locationX>182</locationX>
        <locationY>431</locationY>
        <defaultConnector>
            <targetReference>Get_Email_Template_ID_no_tax</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>NO</defaultConnectorLabel>
        <rules>
            <name>YES_US_Donor</name>
            <conditionLogic>or</conditionLogic>
            <conditions>
                <leftValueReference>$Record.Donor.BillingCountry</leftValueReference>
                <operator>Contains</operator>
                <rightValue>
                    <stringValue>United States</stringValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Get_Email_Template_ID_tax_language</targetReference>
            </connector>
            <label>YES - U.S.</label>
        </rules>
    </decisions>
    <decisions>
        <description>Is the donor a Person Account? If not, then is the Acknowledgment Recipient filled out on the Org Account Donor that&apos;s listed on the GT?</description>
        <name>Is_there_a_Recipient_ID</name>
        <label>Is there a Recipient ID?</label>
        <locationX>380</locationX>
        <locationY>323</locationY>
        <defaultConnector>
            <targetReference>Send_Email_when_no_Recipient</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>NO</defaultConnectorLabel>
        <rules>
            <name>Yes_Recipient_ID</name>
            <conditionLogic>or</conditionLogic>
            <conditions>
                <leftValueReference>$Record.Donor.IsPersonAccount</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.Donor.Acknowledgment_Recipient__r.Id</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Is_Donor_from_the_US</targetReference>
            </connector>
            <label>Yes Recipient ID</label>
        </rules>
    </decisions>
    <description>Add branching logic for Tax vs Non-tax letters. [Arkus/BL 4-4-25]</description>
    <environments>Default</environments>
    <formulas>
        <description>If donor on the GT is a person account, then formula displays that Donor&apos;s Contact Id. If donor on the GT is an Organization Account, then formula displays the Contact ID of the Acknowledgment Recipient on the Donor Account.</description>
        <name>f_RecipientId</name>
        <dataType>String</dataType>
        <expression>IF(
{!$Record.Donor.IsPersonAccount} = TRUE,
{!$Record.Donor.PersonContactId},
{!$Record.Donor.Acknowledgment_Recipient__r.Id}
)</expression>
    </formulas>
