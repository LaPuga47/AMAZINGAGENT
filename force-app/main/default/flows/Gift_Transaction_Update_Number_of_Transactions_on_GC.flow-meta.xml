<?xml version="1.0" encoding="UTF-8"?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>66.0</apiVersion>
    <areMetricsLoggedToDataCloud>false</areMetricsLoggedToDataCloud>
    <assignments>
        <description>Count the Gift Transactions we just found</description>
        <name>Count_Gift_Transactions</name>
        <label>Count Gift Transactions</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignmentItems>
            <assignToReference>var_countGiftTransactions</assignToReference>
            <operator>AssignCount</operator>
            <value>
                <elementReference>Get_all_transactions_related_to_the_GC</elementReference>
            </value>
        </assignmentItems>
        <connector>
            <targetReference>Update_Number_of_Transactions_on_GC</targetReference>
        </connector>
    </assignments>
    <decisions>
        <description>Checks the Record Type of the Gift Commitment listed on the Triggering Gift Transaction to see if it&apos;s a grant.</description>
        <name>Is_it_a_Grant_Gift_Commitment</name>
        <label>Is it a Grant Gift Commitment?</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnectorLabel>No</defaultConnectorLabel>
        <rules>
            <name>Yes_GrantGC</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>$Record.GiftCommitment.RecordType.DeveloperName</leftValueReference>
                <operator>Contains</operator>
                <rightValue>
                    <stringValue>Grant</stringValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Get_all_transactions_related_to_the_GC</targetReference>
            </connector>
            <label>Yes</label>
        </rules>
    </decisions>
    <description>Runs on Create of a Gift Transaction where Gift Commitment ID is populated, finds the related Gift Commitment, counts all of that GC&apos;s transactions, then updates the &quot;Number of Transactions&quot; field on the GC. [Arkus/BL 2026-03-25]</description>
    <environments>Default</environments>
    <interviewLabel>Gift Transaction: Update &quot;Number of Transactions&quot; on GC {!$Flow.CurrentDateTime}</interviewLabel>
    <label>Gift Transaction: Update &quot;Number of Transactions&quot; on GC</label>
    <processMetadataValues>
        <name>BuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>CanvasMode</name>
        <value>
            <stringValue>AUTO_LAYOUT_CANVAS</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>OriginBuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processType>AutoLaunchedFlow</processType>
    <recordLookups>
        <name>Get_all_transactions_related_to_the_GC</name>
        <label>Get all transactions related to the GC</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignNullValuesIfNoRecordsFound>false</assignNullValuesIfNoRecordsFound>
        <connector>
            <targetReference>Count_Gift_Transactions</targetReference>
        </connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>GiftCommitmentId</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>$Record.GiftCommitmentId</elementReference>
            </value>
        </filters>
        <getFirstRecordOnly>false</getFirstRecordOnly>
        <object>GiftTransaction</object>
        <storeOutputAutomatically>true</storeOutputAutomatically>
    </recordLookups>
    <recordUpdates>
        <description>Find the Gift commitment that we found earlier in the flow (the one related to the Triggering Gift Commitment), and update &quot;Number of Transactions&quot; with the count of gift transactions.</description>
        <name>Update_Number_of_Transactions_on_GC</name>
        <label>Update &quot;Number of Transactions&quot; on GC</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <filterLogic>and</filterLogic>
        <filters>
            <field>Id</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>$Record.GiftCommitmentId</elementReference>
            </value>
        </filters>
        <inputAssignments>
            <field>Number_of_Transactions__c</field>
            <value>
                <elementReference>var_countGiftTransactions</elementReference>
            </value>
        </inputAssignments>
        <inputReference>$Record.GiftCommitment</inputReference>
    </recordUpdates>
    <start>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <connector>
            <targetReference>Is_it_a_Grant_Gift_Commitment</targetReference>
        </connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>GiftCommitmentId</field>
            <operator>IsNull</operator>
            <value>
                <booleanValue>false</booleanValue>
            </value>
        </filters>
        <object>GiftTransaction</object>
        <recordTriggerType>CreateAndUpdate</recordTriggerType>
        <triggerType>RecordAfterSave</triggerType>
    </start>
    <status>Active</status>
    <variables>
        <name>var_countGiftTransactions</name>
        <dataType>Number</dataType>
        <isCollection>false</isCollection>
        <isInput>false</isInput>
        <isOutput>false</isOutput>
        <scale>0</scale>
    </variables>
</Flow>
