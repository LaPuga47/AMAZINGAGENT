<?xml version="1.0" encoding="UTF-8"?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>63.0</apiVersion>
    <areMetricsLoggedToDataCloud>false</areMetricsLoggedToDataCloud>
    <decisions>
        <description>Checks the Gift Commitment record type and takes actions accordingly.</description>
        <name>Gift_Commitment_Record_Type</name>
        <label>Gift Commitment Record Type</label>
        <locationX>270</locationX>
        <locationY>287</locationY>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>Grant</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>$Record.Gift_Commitment__r.RecordType.Name</leftValueReference>
                <operator>Contains</operator>
                <rightValue>
                    <stringValue>Grant</stringValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Update_Grant_Reporter_Name_and_Email</targetReference>
            </connector>
            <label>Grant</label>
        </rules>
        <rules>
            <name>Debt_Prospecting</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>$Record.Gift_Commitment__r.RecordType.Name</leftValueReference>
                <operator>Contains</operator>
                <rightValue>
                    <stringValue>Debt</stringValue>
                </rightValue>
            </conditions>
            <label>Debt Prospecting</label>
        </rules>
    </decisions>
    <description>On create of a Grant Report record where the Grant Reporter Name or Grant Reporter email are blank, then go get the Name and email of the Gratn Reporter listed on the related Opportunity. Created by Arkus/BL 03-05-2025
Added Decision for record type. Arkus BL/3-5-25</description>
    <environments>Default</environments>
    <formulas>
        <description>Holds first and last name from the Grant Reporter on the related Gift Commitment &gt; Opportunity.</description>
        <name>f_GrantReporterName</name>
        <dataType>String</dataType>
        <expression>{!$Record.Gift_Commitment__r.Opportunity.Opportunity_Grant_Reporter__r.FirstName} &amp; &quot; &quot; &amp; {!$Record.Gift_Commitment__r.Opportunity.Opportunity_Grant_Reporter__r.LastName}</expression>
    </formulas>
    <interviewLabel>Grant Report: Populate Grant Reporter Name &amp; Email {!$Flow.CurrentDateTime}</interviewLabel>
    <label>Grant Report: Populate Grant Reporter Name &amp; Email</label>
    <processMetadataValues>
        <name>BuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>CanvasMode</name>
        <value>
            <stringValue>AUTO_LAYOUT_CANVAS</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>OriginBuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processType>AutoLaunchedFlow</processType>
    <recordUpdates>
        <name>Update_Grant_Reporter_Name_and_Email</name>
        <label>Update Grant Reporter Name and Email</label>
        <locationX>50</locationX>
        <locationY>395</locationY>
        <inputAssignments>
            <field>Grant_Reporter_Email_Address__c</field>
            <value>
                <elementReference>$Record.Gift_Commitment__r.Opportunity.Opportunity_Grant_Reporter__r.Email</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>Grant_Reporter_Name__c</field>
            <value>
                <elementReference>f_GrantReporterName</elementReference>
            </value>
        </inputAssignments>
        <inputReference>$Record</inputReference>
    </recordUpdates>
    <start>
        <locationX>144</locationX>
        <locationY>0</locationY>
        <connector>
            <targetReference>Gift_Commitment_Record_Type</targetReference>
        </connector>
        <filterLogic>or</filterLogic>
        <filters>
            <field>Grant_Reporter_Name__c</field>
            <operator>IsNull</operator>
            <value>
                <booleanValue>true</booleanValue>
            </value>
        </filters>
        <filters>
            <field>Grant_Reporter_Email_Address__c</field>
            <operator>IsNull</operator>
            <value>
                <booleanValue>true</booleanValue>
            </value>
        </filters>
        <object>Grant_Report__c</object>
        <recordTriggerType>Create</recordTriggerType>
        <triggerType>RecordBeforeSave</triggerType>
    </start>
    <status>Active</status>
</Flow>
