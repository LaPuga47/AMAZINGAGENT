    <decisions>
        <description>Arkus (OT) 10/08/2024 if it&apos;s a grant opp - record should be treated differently</description>
        <name>Record_Type_Routing</name>
        <label>Record Type Routing</label>
        <locationX>1062</locationX>
        <locationY>323</locationY>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>Opportunity_RT_Grant</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>$Record.RecordType.Name</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Grant</stringValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Get_RecordTypeID_for_Grant_Gift_Commitment</targetReference>
            </connector>
            <label>Opportunity RT = Grant</label>
        </rules>
        <rules>
            <name>Opportunity_RT_Debt_Prospecting</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>$Record.RecordType.Name</leftValueReference>
                <operator>Contains</operator>
                <rightValue>
                    <stringValue>Debt</stringValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Get_RecordTypeID_for_Debt_Gift_Commitment</targetReference>
            </connector>
            <label>Opportunity RT = Debt Prospecting</label>
        </rules>
    </decisions>
    <decisions>
        <name>What_s_the_Opp_Stage</name>
        <label>What&apos;s the Opp Stage?</label>
        <locationX>578</locationX>
        <locationY>539</locationY>
        <defaultConnector>
            <targetReference>Set_Gift_Commitment_Values_Grant</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>Pipeline</name>
            <conditionLogic>or</conditionLogic>
            <conditions>
                <leftValueReference>$Record.StageName</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Prospect - New Grant</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.StageName</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Prospect - Renewal</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.StageName</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Proposal invited</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.StageName</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Proposal submitted</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.StageName</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Contract negotiation</stringValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Assign_GC_Status_Commit_Pipeline</targetReference>
            </connector>
            <label>Pipeline</label>
        </rules>
        <rules>
            <name>Awarded</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>$Record.StageName</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Grant Awarded</stringValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Assign_GC_Status_Commit_Awarded</targetReference>
            </connector>
            <label>Awarded</label>
        </rules>
        <rules>
            <name>Closed</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>$Record.StageName</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Grant Closed</stringValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Assign_GC_Status_Commit_Closed</targetReference>
            </connector>
            <label>Closed</label>
        </rules>
        <rules>
            <name>Denied_Did_not_Pursue</name>
            <conditionLogic>or</conditionLogic>
            <conditions>
                <leftValueReference>$Record.StageName</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Denied</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.StageName</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Did not Pursue</stringValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Assign_GC_Status_Denied</targetReference>
            </connector>
            <label>Denied/Did not Pursue</label>
        </rules>
    </decisions>
    <description>This is a version of the after-save flow that does not create a gift transaction. [Arkus/njf: 2025-03-27]</description>
    <environments>Default</environments>
    <formulas>
        <description>Determines Gift Commitment record type ID based on the record type of the triggering Opportunity</description>
        <name>f_GiftCommitmentRecordTypeID</name>
        <dataType>String</dataType>
        <expression>IF(
    {!$Record.RecordType.Name} = &quot;Grant&quot;, 
    {!Get_RecordTypeID_for_Grant_Gift_Commitment.Id}, 
    IF(
        {!$Record.RecordType.Name} = &quot;Debt Prospecting&quot;, 
        {!Get_RecordTypeID_for_Debt_Gift_Commitment.Id}, 
        {!Get_RecordTypeID_for_Grant_Gift_Commitment.Id}
    )
)</expression>
    </formulas>
    <formulas>
        <description>Arkus (OT) 10/08/2024 sets a last date of the month as a</description>
        <name>fXDate_LastDayofTheMonth</name>
        <dataType>Date</dataType>
        <expression>DATE(
  YEAR(TODAY()),
  MONTH(TODAY()) + 1,
  1
) - 1</expression>
    </formulas>
    <formulas>
        <description>Arkus (OT) 10/08/2024 conditional if it&apos;s a person account (since it uses contact first and last name) vs account name for non-person accounts</description>
        <name>fxT_AccountName</name>
        <dataType>String</dataType>
        <expression>IF(
  $Record.Account.IsPersonAccount, 
  $Record.Account.FirstName &amp; &quot; &quot; &amp; $Record.Account.LastName, 
  $Record.Account.Name
)</expression>
    </formulas>
    <formulas>
        <description>formula displays the first three characters of the donor name from the Opportunity record. Arkus (BL)</description>
        <name>fxT_DonorFirstThreeCharacters</name>
        <dataType>String</dataType>
        <expression>IF(
  $Record.Account.IsPersonAccount, 
  UPPER(LEFT({!$Record.Account.FirstName}, 3)),
  UPPER(LEFT({!$Record.Account.Name}, 3)) 
)</expression>
    </formulas>
    <formulas>
        <name>fxT_GiftCommitmentName</name>
        <dataType>String</dataType>
        <expression>{!$Record.Name}</expression>
    </formulas>
    <formulas>
        <description>Arkus (BL) 2-24-2025 standard naming convention for gift transaction record (minus the auto number)</description>
        <name>fxT_GiftTransactionName</name>
        <dataType>String</dataType>
        <expression>&quot;GT&quot; &amp; 

(IF(
  $Record.Account.IsPersonAccount, 
  UPPER(LEFT({!$Record.Account.FirstName}, 3)),
  UPPER(LEFT({!$Record.Account.Name}, 3)) 
)) &amp; 

TEXT(YEAR( {!$Flow.CurrentDate} )) &amp; 
TEXT(MONTH( {!$Flow.CurrentDate} )) &amp; 
TEXT(DAY( {!$Flow.CurrentDate} ))</expression>
    </formulas>
