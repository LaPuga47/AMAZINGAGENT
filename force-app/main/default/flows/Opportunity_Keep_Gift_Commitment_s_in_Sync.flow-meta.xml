    <description>This version includes a null check when finding the Gift Commitments. So if there are no Gift Commitments, the flow ends because there&apos;s no record that needs to be kept in sync. 

Added Branch for Investment Note Opportunities to keep in sync

Runs on ALL Opportunity record types.

V7 (Arkus/BL 12-15-25): On the Investment Note path, get the Gift Commitment record type ID called &quot;Investment Note&quot; and apply it to the Gift Commitment record related to the triggering Opportunity.</description>
    <environments>Default</environments>
    <interviewLabel>Opportunity: Keep Gift Commitment(s) in Sync {!$Flow.CurrentDateTime}</interviewLabel>
    <label>Opportunity: Keep Gift Commitment(s) in Sync</label>
    <processMetadataValues>
        <name>BuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>CanvasMode</name>
        <value>
            <stringValue>AUTO_LAYOUT_CANVAS</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>OriginBuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processType>AutoLaunchedFlow</processType>
    <recordLookups>
        <description>Get Gift Commitment records where this Opportunity is listed in the Opportunity lookup (usually there is only one Gift Commitment related to a Grant Opportunity, this finds only the first one.)</description>
        <name>Get_Gift_Commitment_Grant</name>
        <label>Get Gift Commitment - Grant</label>
        <locationX>182</locationX>
        <locationY>431</locationY>
        <assignNullValuesIfNoRecordsFound>false</assignNullValuesIfNoRecordsFound>
        <connector>
            <targetReference>Grant_Gift_Commitment_Found</targetReference>
        </connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>OpportunityId</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>$Record.Id</elementReference>
            </value>
        </filters>
        <getFirstRecordOnly>true</getFirstRecordOnly>
        <object>GiftCommitment</object>
        <storeOutputAutomatically>true</storeOutputAutomatically>
    </recordLookups>
    <recordLookups>
