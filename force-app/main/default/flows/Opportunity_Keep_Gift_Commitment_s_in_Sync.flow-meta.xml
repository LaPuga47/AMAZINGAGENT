    <start>
        <locationX>782</locationX>
        <locationY>0</locationY>
        <connector>
            <targetReference>Opportunity_Record_Type</targetReference>
        </connector>
        <filterFormula>(
ISCHANGED({!$Record.Name}) ||
ISCHANGED({!$Record.Amount}) ||
ISCHANGED({!$Record.CloseDate}) ||
ISCHANGED({!$Record.End_Date__c}) ||
ISCHANGED({!$Record.OwnerId}) ||
(ISCHANGED({!$Record.Opportunity_Grant_Reporter__c}) &amp;&amp; NOT(ISBLANK({!$Record.Opportunity_Grant_Reporter__c})) )
)

||
CONTAINS({!$Record.RecordType.Name}, &quot;Debt&quot;) &amp;&amp;
(
ISCHANGED({!$Record.Name}) ||
ISCHANGED({!$Record.Amount}) ||
ISCHANGED({!$Record.CloseDate}) ||
ISCHANGED({!$Record.End_Date__c}) ||
ISCHANGED({!$Record.OwnerId}) ||
ISCHANGED({!$Record.Note_Number__c}) ||
ISCHANGED({!$Record.Investor__c}) ||
(ISCHANGED({!$Record.Opportunity_Grant_Reporter__c}) &amp;&amp; NOT(ISBLANK({!$Record.Opportunity_Grant_Reporter__c}) ) ) 
)</filterFormula>
        <object>Opportunity</object>
        <recordTriggerType>CreateAndUpdate</recordTriggerType>
        <triggerType>RecordAfterSave</triggerType>
    </start>
    <status>Active</status>
