<?xml version="1.0" encoding="UTF-8"?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>66.0</apiVersion>
    <areMetricsLoggedToDataCloud>false</areMetricsLoggedToDataCloud>
    <decisions>
        <description>Did the get records element find any Gift Transactions related to the Opportunity&apos;s Gift Commitment so that the Commitment Amount vs. Total Transactions is equal to zero?</description>
        <name>Transactions_Found</name>
        <label>Transactions Found</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnector>
            <targetReference>Update_has_Needed_Transactions_to_False</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>No</defaultConnectorLabel>
        <rules>
            <name>Yes</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>Get_GC_s_where_Amount_vs_Total_Transactions_is_NOT_0</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Update_has_Needed_Transactions_to_True</targetReference>
            </connector>
            <label>Yes</label>
        </rules>
    </decisions>
    <description>Flow updates the field on the Opportunity record that indicates whether there are Needed transactions related to this Opportunity.</description>
    <environments>Default</environments>
    <interviewLabel>Opportunity: Update the Has Needed Transactions Field {!$Flow.CurrentDateTime}</interviewLabel>
    <label>Opportunity: Update the Has Needed Transactions Field</label>
    <processMetadataValues>
        <name>BuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>CanvasMode</name>
        <value>
            <stringValue>AUTO_LAYOUT_CANVAS</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>OriginBuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processType>AutoLaunchedFlow</processType>
    <recordLookups>
        <description>Go get Gift Commitment records related to the triggering Opportunity record where the total Transaction amount vs. the Commitment Amount is NOT equal to $0</description>
        <name>Get_GC_s_where_Amount_vs_Total_Transactions_is_NOT_0</name>
        <label>Get GC&apos;s where Amount vs. Total Transactions is NOT 0</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignNullValuesIfNoRecordsFound>false</assignNullValuesIfNoRecordsFound>
        <connector>
            <targetReference>Transactions_Found</targetReference>
        </connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>Commitment_Amount_vs_Total_Transactions__c</field>
            <operator>EqualTo</operator>
            <value>
                <numberValue>0.0</numberValue>
            </value>
        </filters>
        <filters>
            <field>OpportunityId</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>$Record.Id</elementReference>
            </value>
        </filters>
        <getFirstRecordOnly>false</getFirstRecordOnly>
        <object>GiftCommitment</object>
        <storeOutputAutomatically>true</storeOutputAutomatically>
    </recordLookups>
    <recordUpdates>
        <description>Update the &quot;Has Needed Transactions&quot; field on the triggering Opportunity to False.</description>
        <name>Update_has_Needed_Transactions_to_False</name>
        <label>Update has Needed Transactions to False</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <inputAssignments>
            <field>Has_Needed_Transactions__c</field>
            <value>
                <booleanValue>false</booleanValue>
            </value>
        </inputAssignments>
        <inputReference>$Record</inputReference>
    </recordUpdates>
    <recordUpdates>
        <description>Update the &quot;Has Needed Transactions&quot; field on the triggering Opportunity to True</description>
        <name>Update_has_Needed_Transactions_to_True</name>
        <label>Update has Needed Transactions to True</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <inputAssignments>
            <field>Has_Needed_Transactions__c</field>
            <value>
                <booleanValue>true</booleanValue>
            </value>
        </inputAssignments>
        <inputReference>$Record</inputReference>
    </recordUpdates>
    <start>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <connector>
            <targetReference>Get_GC_s_where_Amount_vs_Total_Transactions_is_NOT_0</targetReference>
        </connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>Has_Needed_Transactions__c</field>
            <operator>EqualTo</operator>
            <value>
                <booleanValue>false</booleanValue>
            </value>
        </filters>
        <object>Opportunity</object>
        <recordTriggerType>CreateAndUpdate</recordTriggerType>
        <triggerType>RecordAfterSave</triggerType>
    </start>
    <status>Obsolete</status>
</Flow>
