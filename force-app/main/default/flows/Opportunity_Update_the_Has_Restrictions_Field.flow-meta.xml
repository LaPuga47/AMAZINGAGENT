<?xml version="1.0" encoding="UTF-8"?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>64.0</apiVersion>
    <areMetricsLoggedToDataCloud>false</areMetricsLoggedToDataCloud>
    <decisions>
        <description>Did the get records element find any Gift Transactions related to the Opportunity where the Restrictions total is greater than $0?</description>
        <name>Restrictions_Found</name>
        <label>Restrictions Found?</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnector>
            <targetReference>Update_Has_Restrictions_to_False</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>No</defaultConnectorLabel>
        <rules>
            <name>Yes</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>Get_GC_s_where_Restrictions_Total_greaterthan_0</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Update_Has_Restrictions_to_True</targetReference>
            </connector>
            <label>Yes</label>
        </rules>
    </decisions>
    <description>This flow runs on create or update of an Opportunity when &quot;Has Restrictions&quot; is null. Flow looks for related Gift Commitments that have restrictions. If it finds them, flow marks &quot;Has Restrictions&quot; as true, if not, it marks &quot;Has Restrictions&quot; as False. [Arkus/BL 6-19-25]
v2 - finds all related Gift Commitment records, not just one. [Arkus/BL 6-19-25]
v3 - modified the flow so it runs after Save [Arkus/BL 6-25-25]
v6 Rev2 - modified to look at Grant Record Type [DJS: 3-26-2026]</description>
    <environments>Default</environments>
    <interviewLabel>Opportunity: Update the Has Restrictions Field {!$Flow.CurrentDateTime}</interviewLabel>
    <label>Opportunity: Update the Has Restrictions Field Rev2</label>
    <processMetadataValues>
        <name>BuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>CanvasMode</name>
        <value>
            <stringValue>AUTO_LAYOUT_CANVAS</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>OriginBuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processType>AutoLaunchedFlow</processType>
    <recordLookups>
        <description>Go get Gift Commitment records related to the triggering Opportunity record where the Restrictions Total is greater than $0</description>
        <name>Get_GC_s_where_Restrictions_Total_greaterthan_0</name>
        <label>Get GC&apos;s where Restrictions Total &gt; 0</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignNullValuesIfNoRecordsFound>false</assignNullValuesIfNoRecordsFound>
        <connector>
            <targetReference>Restrictions_Found</targetReference>
        </connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>Restrictions_Total__c</field>
            <operator>GreaterThan</operator>
            <value>
                <numberValue>0.0</numberValue>
            </value>
        </filters>
        <filters>
            <field>OpportunityId</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>$Record.Id</elementReference>
            </value>
        </filters>
        <getFirstRecordOnly>false</getFirstRecordOnly>
        <object>GiftCommitment</object>
        <storeOutputAutomatically>true</storeOutputAutomatically>
    </recordLookups>
    <recordUpdates>
        <description>Update the &quot;Has Restrictions&quot; field on the triggering Opportunity to False.</description>
        <name>Update_Has_Restrictions_to_False</name>
        <label>Update Has Restrictions to False</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <inputAssignments>
            <field>Has_Restrictions__c</field>
            <value>
                <booleanValue>false</booleanValue>
            </value>
        </inputAssignments>
        <inputReference>$Record</inputReference>
    </recordUpdates>
    <recordUpdates>
        <description>Update the &quot;Has Restrictions&quot; field on the triggering Opportunity to True.</description>
        <name>Update_Has_Restrictions_to_True</name>
        <label>Update Has Restrictions to True</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <inputAssignments>
            <field>Has_Restrictions__c</field>
            <value>
                <booleanValue>true</booleanValue>
            </value>
        </inputAssignments>
        <inputReference>$Record</inputReference>
    </recordUpdates>
    <start>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <connector>
            <targetReference>Get_GC_s_where_Restrictions_Total_greaterthan_0</targetReference>
        </connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>RecordTypeId</field>
            <operator>EqualTo</operator>
            <value>
                <stringValue>012cv000000EkJDAA0</stringValue>
            </value>
        </filters>
        <object>Opportunity</object>
        <recordTriggerType>CreateAndUpdate</recordTriggerType>
        <triggerType>RecordAfterSave</triggerType>
    </start>
    <status>Active</status>
</Flow>
