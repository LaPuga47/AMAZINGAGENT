    <decisions>
        <name>Were_Gift_Commitments_selected</name>
        <label>Were Gift Commitments selected?</label>
        <locationX>182</locationX>
        <locationY>134</locationY>
        <defaultConnector>
            <targetReference>Go_Select_GCs</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>NO</defaultConnectorLabel>
        <rules>
            <name>YES_GC_selected</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>ids</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Get_Gift_Commitments</targetReference>
            </connector>
            <label>YES</label>
        </rules>
    </decisions>
    <description>Send End of Year tax letter. This flow is launched by a button on the Gift Commitment List view.</description>
    <environments>Default</environments>
    <formulas>
        <description>If Donor on the Gift Commitment is a person account, then use the Contact ID related to the Donor ID. If the Donor of the Gift Commitment is an Organization Account, then use the &quot;Acknowledgement Recipient&quot; on the Donor Account (which is a person account).</description>
        <name>f_RecipientID</name>
        <dataType>String</dataType>
        <expression>IF({!Loop_through_GCs.Donor.IsPersonAccount} = True, {!Loop_through_GCs.Donor.PersonContactId}, 
{!Loop_through_GCs.Donor.Acknowledgment_Recipient__r.Id}
)</expression>
    </formulas>
    <interviewLabel>Send End Of Year Tax Letter {!$Flow.CurrentDateTime}</interviewLabel>
    <label>Send End Of Year Tax Letter</label>
    <loops>
        <description>Check all of the GCs that were selected in the list view and send an ack to each one.</description>
        <name>Loop_through_GCs</name>
        <label>Loop through GCs</label>
        <locationX>50</locationX>
        <locationY>566</locationY>
        <collectionReference>Get_Gift_Commitments</collectionReference>
        <iterationOrder>Asc</iterationOrder>
        <nextValueConnector>
            <targetReference>Send_Ack_Email</targetReference>
        </nextValueConnector>
        <noMoreValuesConnector>
            <targetReference>Success_Screen</targetReference>
        </noMoreValuesConnector>
    </loops>
