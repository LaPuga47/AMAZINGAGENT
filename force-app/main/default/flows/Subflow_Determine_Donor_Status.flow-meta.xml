    <decisions>
        <name>Determine_Donor_Status</name>
        <label>Determine Donor Status</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>New</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>Get_Donor_Gift_Summary_DGS.FirstGiftDate</leftValueReference>
                <operator>GreaterThanOrEqualTo</operator>
                <rightValue>
                    <elementReference>f_Last335Days</elementReference>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Assign_New</targetReference>
            </connector>
            <label>New</label>
        </rules>
        <rules>
            <name>Ongoing</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>Get_Donor_Gift_Summary_DGS.LastGiftDate</leftValueReference>
                <operator>GreaterThan</operator>
                <rightValue>
                    <elementReference>f_Last365Days</elementReference>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>Get_Donor_Gift_Summary_DGS.FirstGiftDate</leftValueReference>
                <operator>LessThanOrEqualTo</operator>
                <rightValue>
                    <elementReference>$Flow.CurrentDate</elementReference>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Assign_Ongoing</targetReference>
            </connector>
            <label>Ongoing</label>
        </rules>
        <rules>
            <name>Soon_to_be_Lapsed</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>Get_Donor_Gift_Summary_DGS.LastGiftDate</leftValueReference>
                <operator>GreaterThan</operator>
                <rightValue>
                    <elementReference>f_Last365Days</elementReference>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>Get_Donor_Gift_Summary_DGS.LastGiftDate</leftValueReference>
                <operator>LessThanOrEqualTo</operator>
                <rightValue>
                    <elementReference>f_Last335Days</elementReference>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Assign_Soon_to_be_Lapsed</targetReference>
            </connector>
            <label>Soon to be Lapsed</label>
        </rules>
        <rules>
            <name>Recent_Lapsed</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>Get_Donor_Gift_Summary_DGS.LastGiftDate</leftValueReference>
                <operator>GreaterThan</operator>
                <rightValue>
                    <elementReference>f_Last730Days</elementReference>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>Get_Donor_Gift_Summary_DGS.LastGiftDate</leftValueReference>
                <operator>LessThanOrEqualTo</operator>
                <rightValue>
                    <elementReference>f_Last335Days</elementReference>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Assign_Recent_Lapsed</targetReference>
            </connector>
            <label>Recent Lapsed</label>
        </rules>
        <rules>
            <name>Lapsed</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>Get_Donor_Gift_Summary_DGS.LastGiftDate</leftValueReference>
                <operator>GreaterThan</operator>
                <rightValue>
                    <elementReference>f_Last1095Days</elementReference>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>Get_Donor_Gift_Summary_DGS.LastGiftDate</leftValueReference>
                <operator>LessThanOrEqualTo</operator>
                <rightValue>
                    <elementReference>f_Last730Days</elementReference>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Assign_Lapsed</targetReference>
            </connector>
            <label>Lapsed</label>
        </rules>
        <rules>
            <name>Lapsed_3</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>Get_Donor_Gift_Summary_DGS.LastGiftDate</leftValueReference>
                <operator>LessThanOrEqualTo</operator>
                <rightValue>
                    <elementReference>f_Last1095Days</elementReference>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Assign_Lapsed_3</targetReference>
            </connector>
            <label>Lapsed 3+</label>
        </rules>
    </decisions>
    <decisions>
        <name>Was_Donor_Gift_Summary_DGS_Found</name>
        <label>Was Donor Gift Summary (DGS) Found?</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnector>
            <targetReference>Assign_Not_Yet_a_Donor</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>No</defaultConnectorLabel>
        <rules>
            <name>Yes_Dates_Blank</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>Get_Donor_Gift_Summary_DGS.FirstGiftDate</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>No_First_Gift_Assign_to_Not_Yet_a_Donor</targetReference>
            </connector>
            <label>Yes, Dates Blank</label>
        </rules>
        <rules>
            <name>Yes_DGS_Found</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>Get_Donor_Gift_Summary_DGS</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Determine_Donor_Status</targetReference>
            </connector>
            <label>Yes</label>
        </rules>
    </decisions>
    <description>Subflow holds the decision logic for setting Donor Status. This flow is auto launched inside of a flow that&apos;s scheduled Daily on Account. 
V3 - Updated decision logic to use first and last gift dates from DGS. Arkus/BL 4-21-26</description>
    <environments>Default</environments>
    <formulas>
        <description>holds the date that is 1095 days before today</description>
        <name>f_Last1095Days</name>
        <dataType>Date</dataType>
        <expression>TODAY() - 1095</expression>
    </formulas>
    <formulas>
        <description>holds the date that is 335 days before today</description>
        <name>f_Last335Days</name>
        <dataType>Date</dataType>
        <expression>TODAY() - 335</expression>
    </formulas>
    <formulas>
        <description>holds the date that is 365 days before today</description>
        <name>f_Last365Days</name>
        <dataType>Date</dataType>
        <expression>TODAY() - 365</expression>
    </formulas>
    <formulas>
        <description>holds the date that is 584 days before today</description>
        <name>f_Last584Days</name>
        <dataType>Date</dataType>
        <expression>TODAY() - 584</expression>
    </formulas>
    <formulas>
        <description>holds the date that is 730 days before today</description>
        <name>f_Last730Days</name>
        <dataType>Date</dataType>
        <expression>TODAY()-730</expression>
    </formulas>
    <interviewLabel>Subflow: Determine Donor Status {!$Flow.CurrentDateTime}</interviewLabel>
    <label>Subflow: Determine Donor Status</label>
