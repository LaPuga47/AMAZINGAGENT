        <localActions>
            <fullName>find_programs_179We000000psxf</fullName>
            <description>Scans all current-scenario budget lines to find programs that need funding, are over-funded, or are tight, ranked by need with the current and next fiscal year first.</description>
            <developerName>find_programs_179We000000psxf</developerName>
            <invocationTarget>AmaizeFindPrograms</invocationTarget>
            <invocationTargetType>apex</invocationTargetType>
            <isConfirmationRequired>false</isConfirmationRequired>
            <isIncludeInProgressIndicator>false</isIncludeInProgressIndicator>
            <localDeveloperName>find_programs</localDeveloperName>
            <masterLabel>Find Programs</masterLabel>
        </localActions>
        <localActions>
            <fullName>get_opportunity_context_179We000000psxf</fullName>
            <description>Resolves a named grant&apos;s eligible country and program from its Restriction (Restriction_Country__c + Business_Unit__c), plus the year from the Opportunity, so a headroom check can run off it. Returns found=true with a single country and program only when the grant resolves to exactly one of each; otherwise found=false and the summary asks which country or program to use.</description>
            <developerName>get_opportunity_context_179We000000psxf</developerName>
            <invocationTarget>AmaizeGetOpportunityContext</invocationTarget>
            <invocationTargetType>apex</invocationTargetType>
            <isConfirmationRequired>false</isConfirmationRequired>
            <isIncludeInProgressIndicator>false</isIncludeInProgressIndicator>
            <localDeveloperName>get_opportunity_context</localDeveloperName>
            <masterLabel>Get Opportunity Context</masterLabel>
        </localActions>
        <localActions>
            <fullName>check_headroom_179We000000psxf</fullName>
            <description>Computes summed funding headroom for a single program in a country (optionally a fiscal year) and returns a Headroom Available / Some Headroom Available / Headroom Unavailable verdict with reasoning.</description>
            <developerName>check_headroom_179We000000psxf</developerName>
            <invocationTarget>AmaizeCheckHeadroom</invocationTarget>
