            <masterLabel>Compare Headroom</masterLabel>
        </localActions>
        <localActions>
            <fullName>analyze_headroom_179We000000q4XQ</fullName>
            <description>Governed Headroom aggregation. Resolves a Headroom category/program (Core Program, Rural Retail, Market Access, Trees, System Change Extension, Unrestricted, Working Capital) to its Budget Line population and SUMS Budget Amount, Secured/Likely/Pipeline/Forecast Funding, Secured/Forecast Headroom across ALL qualifying lines for the country and fiscal year, plus the line count and derived Headroom Status. Returns found=true with the aggregated figures, a governed zero for Unrestricted/Working Capital, or found=false when the category is not yet configured, no qualifying lines exist, or the category/country is missing.</description>
            <developerName>analyze_headroom_179We000000q4XQ</developerName>
            <invocationTarget>AmaizeAnalyzeHeadroom</invocationTarget>
            <invocationTargetType>apex</invocationTargetType>
            <isConfirmationRequired>false</isConfirmationRequired>
            <isIncludeInProgressIndicator>false</isIncludeInProgressIndicator>
