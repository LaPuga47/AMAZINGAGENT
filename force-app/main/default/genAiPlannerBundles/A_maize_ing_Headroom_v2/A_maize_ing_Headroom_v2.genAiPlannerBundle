        <localActions>
            <fullName>analyze_headroom_v2</fullName>
            <description>Identifies a single Budget Line from its dimensions and reports its budget, secured/likely/pipeline funding and headroom. Returns found=true only when exactly one Budget Line matches; otherwise asks for the missing dimension, lists how matches differ, or reports none found.</description>
            <developerName>analyze_headroom_v2</developerName>
            <invocationTarget>AmaizeAnalyzeHeadroom</invocationTarget>
            <invocationTargetType>apex</invocationTargetType>
            <isConfirmationRequired>false</isConfirmationRequired>
            <isIncludeInProgressIndicator>false</isIncludeInProgressIndicator>
            <localDeveloperName>analyze_headroom</localDeveloperName>
            <masterLabel>Analyze Budget Line Headroom</masterLabel>
        </localActions>
        <localActions>
            <fullName>rank_headroom_v2</fullName>
            <description>Ranks current-scenario Budget Lines by forecast headroom for portfolio questions — most headroom / largest gap, or over-allocated. Each Budget Line is listed separately; they are never merged.</description>
            <developerName>rank_headroom_v2</developerName>
            <invocationTarget>AmaizeRankHeadroom</invocationTarget>
            <invocationTargetType>apex</invocationTargetType>
            <isConfirmationRequired>false</isConfirmationRequired>
            <isIncludeInProgressIndicator>false</isIncludeInProgressIndicator>
            <localDeveloperName>rank_headroom</localDeveloperName>
            <masterLabel>Rank Budget Line Headroom</masterLabel>
        </localActions>
        <localActions>
            <fullName>get_opportunity_context_v2</fullName>
            <description>Resolves a named grant&apos;s eligible country and program from its Restriction (Restriction_Country__c + Business_Unit__c), plus the year from the Opportunity, so a headroom check can run off it. Returns found=true with a single country and program only when the grant resolves to exactly one of each; otherwise found=false and the summary asks which to use.</description>
            <developerName>get_opportunity_context_v2</developerName>
            <invocationTarget>AmaizeGetOpportunityContext</invocationTarget>
            <invocationTargetType>apex</invocationTargetType>
            <isConfirmationRequired>false</isConfirmationRequired>
            <isIncludeInProgressIndicator>false</isIncludeInProgressIndicator>
            <localDeveloperName>get_opportunity_context</localDeveloperName>
            <masterLabel>Get Opportunity Context</masterLabel>
        </localActions>
        <localDeveloperName>headroom_analysis</localDeveloperName>
        <masterLabel>Headroom Analysis</masterLabel>
