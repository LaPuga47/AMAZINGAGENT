        <localActions>
            <fullName>get_opportunity_context_179We000000q0IW</fullName>
            <description>Resolves a named grant&apos;s eligible country and program from its Restriction (Restriction_Country__c + Business_Unit__c), plus the year from the Opportunity, so a headroom check can run off it. Returns found=true with a single country and program only when the grant resolves to exactly one of each; otherwise found=false and the summary asks which country or program to use.</description>
            <developerName>get_opportunity_context_179We000000q0IW</developerName>
            <invocationTarget>AmaizeGetOpportunityContext</invocationTarget>
            <invocationTargetType>apex</invocationTargetType>
            <isConfirmationRequired>false</isConfirmationRequired>
            <isIncludeInProgressIndicator>false</isIncludeInProgressIndicator>
            <localDeveloperName>get_opportunity_context</localDeveloperName>
            <masterLabel>Get Opportunity Context</masterLabel>
        </localActions>
        <localActions>
            <fullName>rank_headroom_179We000000q0IW</fullName>
            <description>Ranks current-scenario Budget Lines by forecast headroom for portfolio questions — which have the most headroom / largest funding gap, or which are over-allocated. Each Budget Line is listed separately with its own dimensions; they are never merged.</description>
            <developerName>rank_headroom_179We000000q0IW</developerName>
            <invocationTarget>AmaizeRankHeadroom</invocationTarget>
            <invocationTargetType>apex</invocationTargetType>
            <isConfirmationRequired>false</isConfirmationRequired>
            <isIncludeInProgressIndicator>false</isIncludeInProgressIndicator>
            <localDeveloperName>rank_headroom</localDeveloperName>
            <masterLabel>Rank Headroom</masterLabel>
        </localActions>
        <localActions>
            <fullName>analyze_headroom_179We000000q0IW</fullName>
            <description>Identifies a single Budget Line from its dimensions and reports its budget, secured/likely/pipeline funding and headroom. Returns found=true only when exactly one Budget Line matches. Otherwise found=false and the summary either asks for the missing required dimension(s), lists how the matching Budget Lines differ so the user can choose, or reports that no Budget Line matched.</description>
            <developerName>analyze_headroom_179We000000q0IW</developerName>
            <invocationTarget>AmaizeAnalyzeHeadroom</invocationTarget>
            <invocationTargetType>apex</invocationTargetType>
            <isConfirmationRequired>false</isConfirmationRequired>
            <isIncludeInProgressIndicator>false</isIncludeInProgressIndicator>
            <localDeveloperName>analyze_headroom</localDeveloperName>
            <masterLabel>Analyze Headroom</masterLabel>
        </localActions>
